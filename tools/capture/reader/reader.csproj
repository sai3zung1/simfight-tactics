<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>reader</AssemblyName>
    <RootNamespace>Sft.Capture.Reader</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202608" />
    <!-- CUE4Parse pulls 9.0.0 in, which carries GHSA-73j8-2gch-69rq -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
  </ItemGroup>

</Project>
